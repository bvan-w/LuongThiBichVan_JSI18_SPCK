rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Quy tắc cho collection feedbacks
    match /feedbacks/{feedbackId} {
      // Bất kỳ ai đã đăng nhập đều được phép đọc toàn bộ feedback
      allow read: if request.auth != null;

      // Người dùng đã đăng nhập có thể gửi feedback của chính mình
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid;
    }

    // Quy tắc cũ cho products
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}